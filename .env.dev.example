# ========== FlowGame 后端（开发/测试环境）==========
# 初始化：cp .env.dev.example .env.dev
# 本地启动：APP_ENV=dev python run.py
FLOWGAME_HOST=0.0.0.0
FLOWGAME_PORT=8009

# 并发与进程（默认不限制并发；本地多 worker 时设 FLOWGAME_UVICORN_WORKERS）
# FLOWGAME_UVICORN_WORKERS=1
# FLOWGAME_MAX_CONCURRENT_WORKFLOWS=0
# FLOWGAME_WORKFLOW_QUEUE_TIMEOUT_SEC=60

# 工作流执行过程日志（未配置时继承 .env；此处可覆盖）
# FLOWGAME_EXECUTION_LOG_ENABLED=true
# FLOWGAME_EXECUTION_LOG_PATH=logs/flowgame-execution.log
# FLOWGAME_EXECUTION_LOG_CONSOLE=true
# FLOWGAME_EXECUTION_LOG_BACKUP_COUNT=5
# FLOWGAME_EXECUTION_LOG_FILE_FIELD_MAX_LEN=50000
# FLOWGAME_EXECUTION_LOG_CONSOLE_FIELD_MAX_LEN=800

# LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
# 与生产环境隔离的命名空间
FLOWGAME_REDIS_KEY_PREFIX=flowgame_dev:
# FLOWGAME_FLOW_DELETE_PASSWORD=change-me

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_TIMEOUT=30
# 与生产环境隔离的 Collection 前缀
FLOWGAME_QDRANT_KB_PREFIX=flowgame_dev_

# Embedding（留空则用本地 model/BAAI/bge-small-zh-v1.5）
# EMBEDDING_API_URL=http://127.0.0.1:8080/embed
EMBEDDING_API_TIMEOUT=30
EMBEDDING_VECTOR_SIZE=512
# EMBEDDING_MODEL_PATH=

# MySQL（databaseNode 使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=your_database
MYSQL_CHARSET=utf8mb4

# 企业微信机器人（robot_channel/qiyeweixing，动态代码 from wecom import …）
# FLOWGAME_WECOM_BOT_ID=
# FLOWGAME_WECOM_BOT_SECRET=
# FLOWGAME_WECOM_CHATID=
# FLOWGAME_WECOM_WEBHOOK_KEY=

# 会话机器人独立 Worker（run.py 默认自动拉起；多 workers 时仍安全）
# FLOWGAME_ROBOT_AUTOSTART=true
# 须与上面 FLOWGAME_PORT 一致（本 example 默认 8009）；不填则 spawn 时按 HOST:PORT 自动拼
# FLOWGAME_ROBOT_API_BASE=http://127.0.0.1:8009
# FLOWGAME_ROBOT_POLL_SEC=2
# FLOWGAME_ROBOT_HEARTBEAT_SEC=10
# FLOWGAME_ROBOT_STALE_SEC=30
# FLOWGAME_ROBOT_PRESENCE_TTL_SEC=30
# 绑定流程 /execute 读超时（秒）；html2pdf / 多 LLM 建议 ≥300
# FLOWGAME_ROBOT_EXECUTE_TIMEOUT_SEC=120
# 机器人工作空间根（默认 src/flowgame/robot_space）
# FLOWGAME_ROBOT_SPACE_DIR=
