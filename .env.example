# ========== FlowGame 后端 ==========
FLOWGAME_HOST=0.0.0.0
FLOWGAME_PORT=8008

# 并发与进程（阶段 0：默认与现网一致，生产可按 CPU 调大）
# FLOWGAME_UVICORN_WORKERS=1
# FLOWGAME_MAX_CONCURRENT_WORKFLOWS=0
# FLOWGAME_WORKFLOW_QUEUE_TIMEOUT_SEC=60

# 工作流执行过程日志（试运行 / execute 时每个节点的开始、结束、耗时等）
# FLOWGAME_EXECUTION_LOG_ENABLED=true
# FLOWGAME_EXECUTION_LOG_PATH=logs/flowgame-execution.log
# Docker 建议：/var/log/flowgame/execution.log 并挂载宿主机目录
# FLOWGAME_EXECUTION_LOG_CONSOLE=true
# FLOWGAME_EXECUTION_LOG_LEVEL=INFO
# FLOWGAME_EXECUTION_LOG_MAX_BYTES=5242880
# FLOWGAME_EXECUTION_LOG_BACKUP_COUNT=5

# LLM
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 可选：多项目共用 Redis 时设置命名空间，如 myapp:（默认 flow_game:）
# 不配置时：以请求头为准（前端 configureFlowGameClient / VITE_FLOWGAME_REDIS_KEY_PREFIX）
# 配置后：后端锁定该前缀，前端须配置成相同值
# FLOWGAME_REDIS_KEY_PREFIX=myapp:

# 流程列表删除密码（非空则 POST /api/v1/flowGame/flows/delete 必须带正确 deletePassword）
# FLOWGAME_FLOW_DELETE_PASSWORD=change-me

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_TIMEOUT=30
# 可选：多项目共用 Qdrant 时设置 Collection 前缀，如 myapp_（默认 flowgame_）
# 不配置时：以请求头为准（前端 VITE_FLOWGAME_QDRANT_KB_PREFIX）
# 配置后：后端锁定该前缀，前端须配置成相同值
# 前端 configureFlowGameClient({ qdrantKbPrefix }) 会通过请求头传入；仅当后端未配置时生效
# FLOWGAME_QDRANT_KB_PREFIX=myapp_

# Embedding（留空则用本地 model/BAAI/bge-small-zh-v1.5）
# EMBEDDING_API_URL=http://127.0.0.1:8080/embed
EMBEDDING_API_TIMEOUT=30
EMBEDDING_VECTOR_SIZE=512
# EMBEDDING_MODEL_PATH=

# HACR 智能分块（仅在上传 .md 且前端勾选时启用；PDF/DOCX 始终经典分片）
# FLOWGAME_HACR_ENABLED=true   # 服务端总开关，false 时拒绝前端 HACR 请求
# FLOWGAME_HACR_LLM_TEMPERATURE=0.2
# FLOWGAME_HACR_CHILDREN_MIN=3
# FLOWGAME_HACR_CHILDREN_MAX=6
# FLOWGAME_HACR_LLM_FALLBACK=true
# FLOWGAME_HACR_MAX_DOCUMENT_CHARS=12000
# FLOWGAME_HACR_MAX_THEMES=30
# FLOWGAME_HACR_MAX_PARENT_TEXT_CHARS=3000
# FLOWGAME_HACR_LLM_MODEL=

# MySQL（databaseNode 使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=your_database
MYSQL_CHARSET=utf8mb4

# 对象存储（ossNode，阿里云 OSS）
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=your-bucket
# OSS_KEY_PREFIX=flowgame/
# OSS_PUBLIC_READ=false
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
# OSS_SIGNED_URL_EXPIRES=3600

# 网页搜索（webSearchNode：免费，无需 API Key）
# 默认 Google News/RSS + DuckDuckGo（对齐 demo_ai_news Scout）；可选 Wikipedia
# WIKIPEDIA_LANG=zh
# Playwright 渠道（qq_news / sina_news）：已含在 requirements.txt；本地还需 playwright install chromium（Docker 已装）
# FLOWGAME_PLAYWRIGHT_ENABLED=true
# FLOWGAME_PLAYWRIGHT_HEADLESS=true
# FLOWGAME_PLAYWRIGHT_DELAY=1.0
# FLOWGAME_PLAYWRIGHT_MAX_PAGES=3

# 网页抓取（fetchUrlNode：对齐 demo FetcherAgent）
# 优先 https://r.jina.ai/{url}，失败再直连 HTML strip
# FLOWGAME_JINA_ENABLED=true

# 图像生成（imageGenNode：OpenAI SDK images.generate）
# 默认对接火山方舟 Seedream；Key/模型在节点侧配置
# （可选）也可在此预留说明，不强制环境变量
